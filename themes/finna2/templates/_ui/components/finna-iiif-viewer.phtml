<?php
/**
 * Viewer for IIIF manifests and collections.
 *
 * @param array    manifestUrls   URLs of IIIF manifests to load
 */
$iiifLogo = $this->imageSrc()->getSourceAddress('iiif_logo.min', allowParentThemes: true);
$pageLabelFormat = $this->pageLabelFormat ?? 'P&nbsp;· L';
$maxZoomLevel = $this->maxZoomLevel;
$iiifToolbar = $this->iiifToolbar;
$finnaIiifNav = $this->finnaIiifNav;
?>

<div class="record-viewer-container container">
  <div class="tify" id="tify"></div>

  <div class="record-iiif-toolbar container">
    <span class="record-iiif-functions dropdown hstack gap-3">
      <button type="button"
        class="btn btn-outline-primary p-2 ms-auto"
        data-bs-toggle="dropdown"
        aria-expanded="false"
      >
        <img src="<?=$this->escapeHtmlAttr($iiifLogo)?>"
             alt="IIIF"
             class="bi"
        >
        <span><?=$this->transEsc('iiif_tools')?></span>
        <?=$this->icon('dropdown-open')?>
      </button>
      <?=$this->component(
        'finna-iiif-menu',
        ['manifestUrls' => $this->manifestUrls, 'alignRight' => true]
      );?>
    </span>
  </div>
</div>

<?php
$tifyJsPath = json_encode($this->scriptSrc('vendor/tify/tify.min.js'));
$tifyConfig = json_encode([
  'container' => '#tify',
  'manifestUrl' => $this->manifestUrls[0]['url'],
  'language' => substr($this->layout()->userLang, 0, 2) ?? 'fi',
  // Default colorMode is "auto" which autodetects the browser preference.
  // Finna does not currently support dark modes, so we must force "light" to
  // prevent mismatching colors.
  'colorMode' => 'light',
  'optionsResetOnPageChange' => ['pan', 'rotation', 'zoom'],
  'pageLabelFormat' => $pageLabelFormat,
  'urlQueryKey' => 'view',
  'urlQueryParams' => [
    'annotationId',
    'annotationsVisible',
    'layers',
    'filters',
    'pages',
    'pan',
    'rotation',
    'zoom',
  ],
  'viewer' => [
    'maxZoomLevel' => $maxZoomLevel,
    'gestureSettingsMouse' => [
      'dblClickToZoom' => true,
    ],
  ]
]);

$js = <<<JS
    import Tify from $tifyJsPath;
    const tify = new Tify($tifyConfig);
    tify.ready.then(() => {

      (function () {

        const iiifNav = document.querySelector('.js-iiif-nav');
        const pageLabel = document.querySelector('.tify-page-name');

        let lastPage = null;

        const getPage = () => {
          const el = pageLabel;
          return el ? String(parseInt(el.textContent, 10)) : null;
        };

        const updateNav = (page) => {
          if (!iiifNav || !page) return;

          iiifNav.querySelectorAll('li').forEach(li => {
            const active = li.dataset.index === page;

            li.classList.toggle('active', active);
            li.toggleAttribute('aria-current', active);

            if (active) {
              li.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
            }
          });
        };

        const sync = () => {
          const page = getPage();
          if (page && page !== lastPage) {
            lastPage = page;
            updateNav(page);
          }
        };

        // Navigation click
        if (iiifNav) {
          iiifNav.addEventListener('click', (e) => {
            const li = e.target.closest('li[data-index]');
            if (li) tify.setPage(Number(li.dataset.index));
          });
        }

        // MutationObserver
        if (pageLabel) {
          const observer = new MutationObserver(sync);
          observer.observe(pageLabel, {
            childList: true,
            subtree: true,
            characterData: true
          });
        }

        // Initial run
        sync();
      })();
    })
    JS;

echo $this->assetManager()->outputInlineScriptString($js, ['type' => 'module']);
?>
