<?php
/**
 * Viewer for IIIF manifests and collections.
 *
 * @param array    manifestUrls   URLs of IIIF manifests to load
 */
$iiifLogo = $this->imageSrc()->getSourceAddress('iiif_logo.min', allowParentThemes: true);
$pageLabelFormat = $this->pageLabelFormat ?? 'P&nbsp;· L';
$maxZoomLevel = $this->maxZoomLevel;
?>

<div class="record-viewer-container container">
  <div class="tify" id="tify"></div>

  <div class="record-iiif-toolbar container">
    <span class="record-iiif-functions dropdown hstack gap-3">
      <button type="button"
        class="btn btn-outline-primary p-2 ms-auto icon-link"
        data-bs-toggle="dropdown"
        aria-expanded="false"
      >
        <img src="<?=$this->escapeHtmlAttr($iiifLogo)?>"
             alt="IIIF"
             class="bi icon-link__icon"
        >
        <span class="icon-link__label"><?=$this->transEsc('iiif_tools')?></span>
        <?=$this->icon('dropdown-open')?>
      </button>
      <?=$this->component(
        'finna-iiif-menu',
        ['manifestUrls' => $this->manifestUrls, 'alignRight' => true]
      );?>
    </span>
  </div>
</div>

<?php
$tifyJsPath = json_encode($this->scriptSrc('vendor/tify/tify.min.js'));
$tifyConfig = json_encode([
  'container' => '#tify',
  'manifestUrl' => $this->manifestUrls[0]['url'],
  'language' => substr($this->layout()->userLang, 0, 2) ?? 'fi',
  // Default colorMode is "auto" which autodetects the browser preference.
  // Finna does not currently support dark modes, so we must force "light" to
  // prevent mismatching colors.
  'colorMode' => 'light',
  'optionsResetOnPageChange' => ['pan', 'rotation', 'zoom'],
  'pageLabelFormat' => $pageLabelFormat,
  'urlQueryKey' => 'view',
  'urlQueryParams' => [
    'annotationId',
    'annotationsVisible',
    'layers',
    'filters',
    'pages',
    'pan',
    'rotation',
    'zoom',
  ],
  'viewer' => [
    'maxZoomLevel' => $maxZoomLevel,
    'gestureSettingsMouse' => [
      'dblClickToZoom' => true,
    ],
  ]
]);

$js = <<<JS
    import Tify from $tifyJsPath;
    const tify = new Tify($tifyConfig);
    tify.ready.then(() => {
      (function () {
        let lastPageName = null;

        function getCurrentPageName() {
          const el = document.querySelector('.tify-page-name .current-page');
          return el ? el.textContent.trim() : null;
        }

        function onPageChange(pageName) {
          console.log('Tify page changed:', pageName);
          const normalizedPage = String(pageName);

          const items = document.querySelectorAll('.list-scrollable li');
          if (!items.length) return;

          items.forEach(li => {
            const isActive = li.dataset.index === normalizedPage;
            li.classList.toggle('active', isActive);

            if (isActive) {
              li.setAttribute('aria-current', 'true');
                          li.scrollIntoView({ behavior: "smooth", block: "end", inline: "center" });
            li.focus({ preventScroll: true });
            } else {
              li.removeAttribute('aria-current');
            }
          });
        }

        function checkForPageChange() {
          const pageName = getCurrentPageName();
          if (pageName && pageName !== lastPageName) {
            lastPageName = pageName;
            onPageChange(pageName);
          }
        }

        // Nav click handling

        document
          .getElementById('image-nav')
          .addEventListener('click', (e) => {

            const li = e.target.closest('li[data-index]');
            if (!li) return;

            const index = Number(li.dataset.index);

            console.log('Thumbnail clicked:', index);
            tify.setPage(index);
        });

        // Observe DOM changes
        const observer = new MutationObserver(() => {
          checkForPageChange();
        });

        observer.observe(document.documentElement, {
          childList: true,
          subtree: true,
          characterData: true,
          attributes: true,
        });

        // Initial check (in case element already exists)
        checkForPageChange();
      })();
    })
    JS;

echo $this->assetManager()->outputInlineScriptString($js, ['type' => 'module']);
?>

